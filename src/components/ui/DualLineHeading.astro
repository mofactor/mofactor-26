---
// Static twin of DualLineHeading.tsx. Only the animated words (if any) run JS.
import BlinkText from "./BlinkText.astro";
import ThinkingText from "./ThinkingText.astro";
import type { BlinkTimingConfig } from "@/lib/fx/blink";

interface BlinkProps {
  mode?: "words" | "chars";
  staggerDelay?: number;
  delay?: number;
  timingConfig?: BlinkTimingConfig;
  inView?: boolean;
}

interface Props {
  as?: string;
  topLine?: string;
  bottomLine?: string;
  blink?: boolean | BlinkProps;
  thinkingWords?: string[];
  thinkingPosition?: "before" | "after";
  /** Same prop name as the React version, so converted pages read the same */
  className?: string;
}

const {
  as: Tag = "h2",
  topLine,
  bottomLine,
  blink = false,
  thinkingWords,
  thinkingPosition = "before",
  className = "",
} = Astro.props;

const blinkProps: BlinkProps | undefined = blink
  ? typeof blink === "object" ? blink : {}
  : undefined;
---

<Tag class={`text-[30px] md:text-[36px] font-normal leading-[1.3] ${className}`}>
  {thinkingPosition === "before" && thinkingWords && (
    <div class="mb-2">
      <ThinkingText class="text-sm text-zinc-400 dark:text-zinc-500 font-mono" words={thinkingWords} />
    </div>
  )}
  {topLine && (
    <span class="text-zinc-400 dark:text-zinc-500">
      {blinkProps ? (
        <BlinkText text={topLine} mode="words" timingConfig={{ fadeTime: 0.35, randomHoldMax: 0.5, blinkTimeMax: 1 }} {...blinkProps} />
      ) : topLine}
    </span>
  )}
  {topLine && bottomLine && <br />}
  {bottomLine && (
    <span class="text-foreground">
      {blinkProps ? (
        <BlinkText text={bottomLine} mode="words" timingConfig={{ fadeTime: 0.5, randomHoldMax: 0.75, blinkTimeMax: 1.5 }} {...blinkProps} />
      ) : bottomLine}
    </span>
  )}
  {thinkingPosition === "after" && thinkingWords && (
    <div class="mt-2">
      <ThinkingText class="text-sm text-zinc-400 dark:text-zinc-500 font-mono" words={thinkingWords} />
    </div>
  )}
</Tag>
