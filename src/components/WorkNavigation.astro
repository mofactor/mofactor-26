---
import { ArrowLeft, ArrowRight } from "lucide-react";
import { visibleWorks as works } from "@/data/works";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const currentPath = `/work/${currentSlug}`;
const currentIndex = works.findIndex((w) => w.href === currentPath);

const prev = currentIndex > 0 ? works[currentIndex - 1] : works[works.length - 1];
const next = currentIndex < works.length - 1 ? works[currentIndex + 1] : works[0];
---

<nav aria-label="Case studies" class="container mb-24">
  <div class="border-t border-zinc-200 dark:border-zinc-800">
    <div class="flex items-center justify-between py-10 md:py-8">
      {/* Previous */}
      <a
        href={prev.href}
        class="group inline-flex items-end gap-4 pr-6 transition-opacity hover:opacity-60"
      >
        <ArrowLeft className="size-4 mb-1 shrink-0 text-muted-foreground transition-transform group-hover:-translate-x-1" />
        <div class="min-w-0">
          <span class="block text-xs uppercase tracking-wider text-muted-foreground mb-1">
            Previous
          </span>
          <span class="block text-lg text-foreground font-medium truncate">
            {prev.title}
          </span>
        </div>
      </a>

      {/* Next */}
      <a
        href={next.href}
        class="group inline-flex items-end gap-4 transition-opacity pl-6 hover:opacity-60"
      >
        <div class="min-w-0 text-right">
          <span class="block text-xs uppercase tracking-wider text-muted-foreground mb-1">
            Next
          </span>
          <span class="block text-lg text-foreground font-medium truncate">
            {next.title}
          </span>
        </div>
        <ArrowRight className="size-4 shrink-0 mb-1 text-muted-foreground transition-transform ease-out group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</nav>
