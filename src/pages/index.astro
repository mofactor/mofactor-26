---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header";
import BottomNav from "@/components/BottomNav";
import Hero from "@/components/home/Hero.astro";
import HeroShader from "@/components/home/HeroShader";
import LogoBar from "@/components/home/LogoBar";
import WorkSection from "@/components/home/WorkSection.astro";
import DesignBits from "@/components/home/DesignBits.astro";
import About from "@/components/home/About.astro";
import Recommendations from "@/components/home/Recommendations.astro";
import BlogPosts from "@/components/home/BlogPosts.astro";
import Contact from "@/components/home/Contact";
import Footer from "@/components/Footer.astro";
---

<Base>
  <Header client:load />
  {/* Toggle nav style: keep one, comment out the other */}
  {/* <Sidebar client:load /> */ /* vertical — fixed left, desktop only (hidden md:block) */}
  <BottomNav client:load /> {/* horizontal — fixed bottom, shown on all breakpoints */}
  <main>
    {/* Hero */}
    <div id="root" class="relative pt-32 pb-16 md:pt-48 md:pb-28 min-h-[40svh]">
      <HeroShader client:idle />
      <div class="container relative z-12">
        <div class="grid grid-cols-1 md:grid-cols-12 items-end gap-10 md:gap-6">
          <div class="md:col-span-8">
            <Hero />
          </div>
          <div class="md:col-span-4">
            <p class="text-muted-foreground-dark pb-2">
              Welcome to Monofactor, portfolio of Onur Oztaskiran, a Senior Product Designer with 15+ years of experience in design and leadership.
            </p>
          </div>
        </div>
        <div class="mt-16 md:mt-28">
          <div class="md:grid md:grid-cols-12 md:gap-6">
            <div class="md:col-span-12">
              <LogoBar client:idle />
            </div>
          </div>
          {/* <div class="mt-7 grid grid-cols-[1fr_auto_1fr] mx-6 items-end gap-3 md:gap-4">
            <div class="border-b border-l border-muted-foreground/30 mb-[0.35em] rounded-bl-xl h-6" />
            <p class="text-xs text-muted-foreground/80 text-center uppercase whitespace-nowrap">those are not fake</p>
            <div class="border-b border-r border-muted-foreground/30 mb-[0.35em] rounded-br-xl h-6" />
          </div> */}
        </div>
      </div>
    </div>

    {/* Work */}
    <div id="work" class=" rounded-t-4xl py-20 md:py-24 md:pt-16 dark:bg-transparent">
      <div class="container">
        <div class="md:grid md:grid-cols-12 md:gap-6">
          <div class="md:col-span-12">
            <WorkSection />
          </div>
        </div>
      </div>
    </div>

    {/* Design Bits */}
    <div id="designbits" class="bg-white dark:bg-zinc-950  py-20 md:py-32">
      <div class="container">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          <div class="md:col-span-12">
            <DesignBits />
          </div>
        </div>
      </div>
    </div>

    {/* About */}
    <div id="about" class="py-24">
      <About />
    </div>

    {/* Recommendations */}
    <div id="recommendations" class="bg-white dark:bg-zinc-950  py-20 md:py-32">
      <div class="container">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          <div class="md:col-span-12">
            <Recommendations />
          </div>
        </div>
      </div>
    </div>

    {/* Journal & Contact */}
    <div id="journal" class="py-20 md:py-32">
      <div class="container">
        <BlogPosts server:defer />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          <div class="md:col-span-12">
            <Contact client:visible />
          </div>
        </div>
      </div>
    </div>


  </main>
  <Footer />
</Base>
