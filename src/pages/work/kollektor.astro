---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header";
import BottomNav from "@/components/BottomNav";
import Footer from "@/components/Footer.astro";
import HeroHeadline from "@/components/ui/HeroHeadline.astro";
import BlinkText from "@/components/ui/BlinkText.astro";
import DualLineHeading from "@/components/ui/DualLineHeading.astro";
import SectionHeaderWrapper from "@/components/ui/SectionHeaderWrapper.astro";
import IntroTextWrapper from "@/components/ui/IntroTextWrapper.astro";
import ProjectMeta from "@/components/ui/ProjectMeta.astro";
import WorkNavigation from "@/components/WorkNavigation.astro";
import { Lightbox } from "@/components/ui/Lightbox";
import { Image } from "astro:assets";
import { img } from "@/lib/images";

const seo = {
  title: "Product Design for Kollektor",
  description: "Designing an AI phone agent for Turkish collection teams: firm in tone, careful with data, and always under the operator's control.",
  path: "/work/kollektor",
  ogImages: [
    { url: "/works/kollektor/kollektor-hero.jpg", width: 1800, height: 1000 },
    { url: "/og?title=Kollektor&subtitle=Voice+AI+Product+Design", width: 1200, height: 630 },
  ],
  twitterImages: ["/works/kollektor/kollektor-hero.jpg"],
};
---

<Base {...seo}>
  <Header client:load />
  <BottomNav client:load items={[
    { label: "Intro", href: "#root" },
    { label: "Overview", href: "#overview" },
    { label: "Tone", href: "#tone" },
    { label: "Guardrails", href: "#guardrails" },
    { label: "Imagery", href: "#imagery" },
    { label: "Outcome", href: "#outcome" },
  ]} />
  <main>
    <article>
      {/* Hero */}
      <section id="root" aria-labelledby="root-title" class="relative py-24">
        <div class="container relative">
          <header class="grid grid-cols-1 md:grid-cols-12 items-end gap-10 md:gap-6 pb-20 pt-32">
            <div class="md:col-span-8">
              <HeroHeadline line1="Voice AI Design" line2="For Kollektor" blink />
            </div>
            <div class="text-muted-foreground-dark dark:text-muted-foreground md:col-span-4">
              <BlinkText
                text="Designing an AI phone agent that calls debtors in Turkish for collection teams, with every call visible to the people in charge."
                mode="words"
                delay={0.1}
                timingConfig={{ fadeTime: 0.35, randomHoldMax: 0.3, blinkTimeMax: 1 }} />
            </div>
          </header>

          <div class="flex flex-col md:flex-row items-start justify-center">
            <div class="relative w-full space-y-6 md:overflow-hidden">
              <ProjectMeta
                variant="grid"
                className="max-w-full md:max-w-[380px] relative md:absolute md:bottom-1 md:left-6 z-10"
                items={[
                  { label: "Role", value: "Product Design & Engineering" },
                  { label: "Period", value: "2026" },
                  { label: "Skills Utilized", value: "Product Design, Conversation Design, Voice AI, Prompt Design, Design Systems, AI Agents", asBadges: true },
                ]} />
              <div class="h-full w-full">
                <Image
                  src={img("/works/kollektor/kollektor-hero.jpg")}
                  alt="Kollektor's product page: a sample call with the agent's line and the saved payment promise"
                  width={1800}
                  quality={100}
                  class="rounded-2xl h-full w-full object-cover max-md:aspect-[1/1] max-md:object-right border border-zinc-200 dark:border-zinc-800"
                  densities={[1, 2]} />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Overview */}
      <section id="overview" aria-labelledby="overview-title" class="pb-24 bg-white dark:bg-zinc-950 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              topLine="Overview:"
              bottomLine="Backstory of the work."
              blink={{ mode: "words" }} />

            <IntroTextWrapper>
              <p>
                Kollektor is an AI phone agent for Turkish law offices and collection teams, now part of <a href="/work/gbo-vision" class="underline underline-offset-4">GBO Vision</a>. It calls debtors in Turkish, verifies who it is talking to, explains the debt and works toward a clear payment promise, while the team's operators watch every call live and can take over at any moment.
              </p>
              <p>
                I shaped the product's identity and the agent's voice, tuned the voice and model stack, designed the Turkish interface and its visual language, and led the move to a real-time backend in September 2026, working alongside an engineer who built the voice worker, flow builder, campaigns and softphone.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>
        </div>
      </section>

      {/* Tone */}
      <section id="tone" aria-labelledby="tone-title" class="pb-24 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              blink
              topLine="Tone."
              bottomLine="Firm, never abusive." />

            <IntroTextWrapper>
              <p>
                A collection call is not customer service, and an agent that apologizes and thanks its way through it gets nowhere. I wrote the tone rules: short turns, consequences stated as facts rather than threats, concrete terms when the conversation stalls, and pressure without abuse.
              </p>
              <p>
                An early version learned from about ninety sample lines and started rehearsing them, sounding scripted. I replaced the samples with principles, and the conversations became natural.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>

          <div class="mt-24">
            <Lightbox client:idle images={[{ src: "/works/kollektor/kollektor-demo.jpg", alt: "Sample Kollektor call: identity check, debt details and a payment plan, with the live transcript" }]}>
              <Image src={img("/works/kollektor/kollektor-demo.jpg")} alt="Sample Kollektor call: identity check, debt details and a payment plan, with the live transcript" width={1800} class="w-full h-auto rounded-2xl border border-zinc-200 dark:border-zinc-800" densities={[1, 2]} />
            </Lightbox>
            <p class="mt-3 text-sm text-zinc-500">Sample data, translated from Turkish.</p>
          </div>
        </div>
      </section>

      {/* Guardrails */}
      <section id="guardrails" aria-labelledby="guardrails-title" class="pb-24 bg-white dark:bg-zinc-950 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              blink
              topLine="Guardrails."
              bottomLine="Rules in the system, not the prompt." />

            <IntroTextWrapper>
              <p>
                The sensitive parts are enforced by the system instead of being left to the model. Identity is checked with only the last four digits of an ID, logs are masked, transcripts are deleted after 90 days, every call opens with a recording notice, nothing is shared with third parties, a do-not-call list is honored, and calls only go out Monday to Saturday between 09:00 and 20:00.
              </p>
              <p>
                People stay in the loop: operators can listen to any call and take it over, and any action that writes data waits for their approval.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>
        </div>
      </section>

      {/* Imagery */}
      <section id="imagery" aria-labelledby="imagery-title" class="pb-24 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              blink
              topLine="Imagery."
              bottomLine="A person, not a robot." />

            <IntroTextWrapper>
              <p>
                For the product's imagery I art-directed AI-generated photography around an ordinary person on an ordinary call, with the agent shown only as a voice. The waveform went through several treatments, from dots to particles, before settling on the one that read as calm rather than technical.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>

          <div data-nav-theme="dark" class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-6">
            <Lightbox client:idle images={[
              { src: "/works/kollektor/kollektor-art-dots.jpg", alt: "Waveform treatment: tech dots" },
              { src: "/works/kollektor/kollektor-art-particles.jpg", alt: "Waveform treatment: particles" },
              { src: "/works/kollektor/kollektor-art-final.jpg", alt: "Waveform treatment: final" },
            ]}>
              <Image src={img("/works/kollektor/kollektor-art-dots.jpg")} alt="Waveform treatment: tech dots" width={1200} class="w-full h-auto rounded-2xl" densities={[1, 2]} />
              <Image src={img("/works/kollektor/kollektor-art-particles.jpg")} alt="Waveform treatment: particles" width={1200} class="w-full h-auto rounded-2xl" densities={[1, 2]} />
              <Image src={img("/works/kollektor/kollektor-art-final.jpg")} alt="Waveform treatment: final" width={1200} class="w-full h-auto rounded-2xl" densities={[1, 2]} />
            </Lightbox>
          </div>
        </div>
      </section>

      {/* Outcome */}
      <section id="outcome" aria-labelledby="outcome-title" class="pb-24 bg-white dark:bg-zinc-950 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="flex-1 md:min-w-[360px]"
              topLine="The Impact."
              bottomLine="Shipping & Outcome." />

            <IntroTextWrapper>
              <p>
                Kollektor handles live calls, with every conversation recorded, transcribed and visible to the team. The September move to a real-time backend carried over every agent, debtor and call, with more than 1,500 tests passing.
              </p>
              <p>
                Designing for a hard conversation taught me that some of the most important design work in an AI product is deciding what the AI must never do, and making sure the system, not the prompt, enforces it.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>
        </div>
      </section>
    </article>
    <WorkNavigation currentSlug="kollektor" />
  </main>
  <Footer />
</Base>
