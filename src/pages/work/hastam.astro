---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header";
import BottomNav from "@/components/BottomNav";
import Footer from "@/components/Footer.astro";
import HeroHeadline from "@/components/ui/HeroHeadline.astro";
import BlinkText from "@/components/ui/BlinkText.astro";
import DualLineHeading from "@/components/ui/DualLineHeading.astro";
import SectionHeaderWrapper from "@/components/ui/SectionHeaderWrapper.astro";
import IntroTextWrapper from "@/components/ui/IntroTextWrapper.astro";
import ProjectMeta from "@/components/ui/ProjectMeta.astro";
import WorkNavigation from "@/components/WorkNavigation.astro";
import { Lightbox } from "@/components/ui/Lightbox";
import { Image } from "astro:assets";
import { img } from "@/lib/images";

const seo = {
  title: "Product & Web Design for Hastam",
  description: "Designing the site and the dashboard language for Hastam, an AI receptionist that answers the phone for clinics while the clinic stays in charge.",
  path: "/work/hastam",
  ogImages: [
    { url: "/works/hastam/hastam-hero.jpg", width: 1800, height: 1000 },
    { url: "/og?title=Hastam&subtitle=Product+%26+Web+Design", width: 1200, height: 630 },
  ],
  twitterImages: ["/works/hastam/hastam-hero.jpg"],
};
---

<Base {...seo}>
  <Header client:load />
  <BottomNav client:load items={[
    { label: "Intro", href: "#root" },
    { label: "Overview", href: "#overview" },
    { label: "Anatomy", href: "#anatomy" },
    { label: "Dashboard", href: "#dashboard" },
    { label: "Site", href: "#site" },
    { label: "Outcome", href: "#outcome" },
  ]} />
  <main>
    <article>
      {/* Hero */}
      <section id="root" aria-labelledby="root-title" class="relative py-24">
        <div class="container relative">
          <header class="grid grid-cols-1 md:grid-cols-12 items-end gap-10 md:gap-6 pb-20 pt-32">
            <div class="md:col-span-8">
              <HeroHeadline line1="Product Design" line2="For Hastam" blink />
            </div>
            <div class="text-muted-foreground-dark dark:text-muted-foreground md:col-span-4">
              <BlinkText
                text="Designing the story and the dashboard language for Hastam, an AI receptionist that answers the phone for clinics."
                mode="words"
                delay={0.1}
                timingConfig={{ fadeTime: 0.35, randomHoldMax: 0.3, blinkTimeMax: 1 }} />
            </div>
          </header>

          <div class="flex flex-col md:flex-row items-start justify-center">
            <div class="relative w-full space-y-6 md:overflow-hidden">
              <ProjectMeta
                variant="grid"
                className="max-w-full md:max-w-[380px] relative md:absolute md:bottom-1 md:left-6 z-10"
                items={[
                  { label: "Role", value: "Product Designer" },
                  { label: "Period", value: "2026" },
                  { label: "Skills Utilized", value: "Product Design, Web Design, Design Systems, Voice UX, Astro, Localization", asBadges: true },
                ]} />
              <div class="h-full w-full">
                <Image
                  src={img("/works/hastam/hastam-hero.jpg")}
                  alt="The hastam.ai homepage with a sample call"
                  width={1800}
                  quality={100}
                  class="rounded-2xl h-full w-full object-cover max-md:aspect-[1/1] max-md:object-right border border-zinc-200 dark:border-zinc-800"
                  densities={[1, 2]} />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Overview */}
      <section id="overview" aria-labelledby="overview-title" class="pb-24 bg-white dark:bg-zinc-950 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              topLine="Overview:"
              bottomLine="Backstory of the work."
              blink={{ mode: "words" }} />

            <IntroTextWrapper>
              <p>
                Hastam is an AI receptionist for independent clinics, made by <a href="/work/gbo-vision" class="underline underline-offset-4">GBO Vision</a>. Patients simply call the clinic's number. The assistant talks with them, takes the appointment request, reschedules, sends them to the right department or takes a message for the doctor, and puts the result on the clinic's screen.
              </p>
              <p>
                My part was the design: the design language of the practitioner dashboard, including the multi-doctor calendar, and the hastam.ai website from first sketch to launch, in Turkish and English.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>
        </div>
      </section>

      {/* Anatomy */}
      <section id="anatomy" aria-labelledby="anatomy-title" class="pb-24 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              blink
              topLine="Anatomy."
              bottomLine="One call, three views." />

            <IntroTextWrapper>
              <p>
                The heart of the site is a single sample call shown three ways at once: what the patient hears, what Hastam does at each step, and what the clinic's team sees. Every check is visible, from telling the caller the call is recorded to confirming the time is still free right before it is written down.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>

          <div data-nav-theme="dark" class="mt-24">
            <Lightbox client:idle images={[{ src: "/works/hastam/hastam-anatomy.jpg", alt: "A sample call broken down into what the patient hears, what Hastam does and what the team sees" }]}>
              <Image src={img("/works/hastam/hastam-anatomy.jpg")} alt="A sample call broken down into what the patient hears, what Hastam does and what the team sees" width={1800} class="w-full h-auto rounded-2xl" densities={[1, 2]} />
            </Lightbox>
          </div>
        </div>
      </section>

      {/* Dashboard */}
      <section id="dashboard" aria-labelledby="dashboard-title" class="pb-24 bg-white dark:bg-zinc-950 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              blink
              topLine="Dashboard."
              bottomLine="The assistant talks. Your team decides." />

            <IntroTextWrapper>
              <p>
                The dashboard is built around control. Urgent calls are flagged and can be taken over live, appointment requests land on the calendar waiting for approval, and the doctor's written answers are read back to the patient by the assistant. I refreshed its design language across the product and designed the multi-doctor calendar.
              </p>
              <p>
                Some decisions are deliberately kept out of the AI's hands: age limits, calling hours and prices are enforced by the system, not left to the conversation.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>

          <div data-nav-theme="dark" class="mt-24">
            <Lightbox client:idle images={[{ src: "/works/hastam/hastam-dashboard.jpg", alt: "The Hastam dashboard with a live urgent call taken over by a doctor" }]}>
              <Image src={img("/works/hastam/hastam-dashboard.jpg")} alt="The Hastam dashboard with a live urgent call taken over by a doctor" width={1800} class="w-full h-auto rounded-2xl" densities={[1, 2]} />
            </Lightbox>
          </div>
        </div>
      </section>

      {/* Site */}
      <section id="site" aria-labelledby="site-title" class="pb-24 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="md:min-w-[360px]"
              blink
              topLine="Site."
              bottomLine="Plain words, one typeface." />

            <IntroTextWrapper>
              <p>
                For the site I kept the rules strict: one typeface, plain words, and none of the decorative tricks that make a page read as generic AI design. It runs in Turkish at the root and English under /en, and works as well on a phone as on a desktop.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>

          <div class="mt-24 grid grid-cols-1 md:grid-cols-3 items-center gap-6">
            <Image src={img("/works/hastam/hastam-phone.jpg")} alt="hastam.ai on a phone" width={780} class="w-full h-auto max-w-[360px] mx-auto rounded-2xl border border-zinc-200 dark:border-zinc-800" densities={[1, 2]} />
            <Image src={img("/works/hastam/hastam-hero-tr.jpg")} alt="The Turkish homepage of hastam.ai" width={1400} class="md:col-span-2 w-full h-auto rounded-2xl border border-zinc-200 dark:border-zinc-800" densities={[1, 2]} />
          </div>
        </div>
      </section>

      {/* Outcome */}
      <section id="outcome" aria-labelledby="outcome-title" class="pb-24 bg-white dark:bg-zinc-950 leading-relaxed">
        <div class="container">
          <SectionHeaderWrapper>
            <DualLineHeading
              className="flex-1 md:min-w-[360px]"
              topLine="The Impact."
              bottomLine="Shipping & Outcome." />

            <IntroTextWrapper>
              <p>
                hastam.ai launched in October 2026 in both languages, and Hastam answers real calls on a clinic's existing phone line.
              </p>
              <p>
                The project sharpened a principle I keep coming back to with AI products: show the work. When a clinic can see exactly what the assistant heard, did and decided, trusting it stops being a leap of faith.
              </p>
            </IntroTextWrapper>
          </SectionHeaderWrapper>
        </div>
      </section>
    </article>
    <WorkNavigation currentSlug="hastam" />
  </main>
  <Footer />
</Base>
